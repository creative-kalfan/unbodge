# UNBODGE Environment Configuration Example
# Copy this file to .env and provide your credentials.
# Existing process environment variables always override values in .env.

# --- Nebius Token Factory / Reasoning ---
# Token Factory Base URL: https://api.tokenfactory.nebius.com/v1
# Studio Base URL (alternative): https://api.studio.nebius.ai/v1
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=Nemotron-3-Ultra-550b-a55b-serverless

# --- Tavily Research ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- LangSmith Tracing (Optional) ---
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=unbodge
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- GitHub Integration ---
GITHUB_TOKEN=your_github_token_here

# --- UNBODGE Services (Optional / Local Dev / Cloud Persistence) ---
UNBODGE_API_TOKEN=your_operator_bearer_token_here
UNBODGE_WEBHOOK_SECRET=your_webhook_hmac_secret_here
# Upstash Redis TLS connection string: rediss://default:<password>@<host>.upstash.io:6379
UNBODGE_REDIS_URL=redis://localhost:6379/0
# Supabase or PostgreSQL DSN: postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require
UNBODGE_POSTGRES_DSN=dbname=unbodge user=postgres password=changeme host=localhost
